generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  name      String?
  avatarUrl String?
  bio       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  receipts Receipt[]
  ratings  Rating[]
  checkins Checkin[]

  @@map("users")
}

model Restaurant {
  id                String   @id @default(cuid())
  name              String
  slug              String   @unique
  googlePlaceId     String?  @unique
  address           String?
  city              String?
  country           String   @default("Turkey")
  latitude          Float?
  longitude         Float?
  googlePhotoRef    String?
  cuisine           String?
  priceRange        Int?
  avgSpendPerPerson Float?
  avgTotalBill      Float?
  receiptCount      Int      @default(0)
  avgRating         Float?
  ratingCount       Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  receipts Receipt[]
  ratings  Rating[]
  checkins Checkin[]

  @@map("restaurants")
}

model Receipt {
  id              String    @id @default(cuid())
  userId          String
  restaurantId    String
  imageUrl        String
  imagePublicId   String?
  parsedData      Json?
  date            DateTime?
  total           Float?
  subtotal        Float?
  tax             Float?
  serviceCharge   Float?
  currency        String    @default("TRY")
  estimatedPeople Int?
  isVerified      Boolean   @default(false)
  isPublished     Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user       User          @relation(fields: [userId], references: [id])
  restaurant Restaurant    @relation(fields: [restaurantId], references: [id])
  items      ReceiptItem[]

  @@map("receipts")
}

model ReceiptItem {
  id         String  @id @default(cuid())
  receiptId  String
  name       String
  quantity   Int     @default(1)
  unitPrice  Float
  totalPrice Float
  category   String?

  receipt Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@map("receipt_items")
}

model Rating {
  id           String   @id @default(cuid())
  userId       String
  restaurantId String
  score        Int
  comment      String?
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id])
  restaurant Restaurant @relation(fields: [restaurantId], references: [id])

  @@unique([userId, restaurantId])
  @@map("ratings")
}

model Checkin {
  id           String   @id @default(cuid())
  userId       String
  restaurantId String
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id])
  restaurant Restaurant @relation(fields: [restaurantId], references: [id])

  @@map("checkins")
}
